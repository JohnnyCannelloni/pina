__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Secrets / local config. .env.example IS committed; .env is not — it is the
# file that would hold a real password once this app talks to anything but
# localhost.
.env

# Node
node_modules/
dist/

# macOS
.DS_Store

# TypeScript incremental build caches. Machine-specific and regenerated by
# `tsc -b`, so they only ever produce noisy diffs and merge conflicts.
*.tsbuildinfo

# Claude Code local settings (permissions for this machine). Not project code.
.claude/

# copy to .env. the defaults match docker-compose.yml.
#
#   cp .env.example .env

# "+psycopg" selects the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://pina:pina@localhost:5432/pina

# pytest only. created by docker/init-test-db.sql.
TEST_DATABASE_URL=postgresql+psycopg://pina:pina@localhost:5432/pina_test

# downloaded openstreetmap extracts. safe to delete; they're re-downloaded
# when needed and saved places live in postgres.
EXTRACT_CACHE_DIR=~/.cache/pina/extracts

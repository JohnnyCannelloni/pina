# Copy to .env — the values below already match docker-compose.yml, so for local
# development you can copy it verbatim and change nothing.
#
#   cp .env.example .env

# The "+psycopg" suffix tells SQLAlchemy which driver to use. Without it you get
# the default postgresql:// dialect, which looks for psycopg2 and fails.
DATABASE_URL=postgresql+psycopg://pina:pina@localhost:5432/pina

# Used only by pytest. Created by docker/init-test-db.sql.
TEST_DATABASE_URL=postgresql+psycopg://pina:pina@localhost:5432/pina_test

# Where downloaded OpenStreetMap country extracts are cached. The first
# destination in a country downloads a few hundred MB here, once; every later
# city in that country is filled from this file in seconds.
#
# Deleting this directory is a safe cache reset — the files are re-downloadable
# and your saved places live in Postgres, not here.
EXTRACT_CACHE_DIR=~/.cache/pina/extracts
